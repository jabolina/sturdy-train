<?xml version="1.0" encoding="UTF-8"?>
<Configuration name="InfinispanServerConfig" monitorInterval="60" shutdownHook="disable">
  <Properties>
    <Property name="path">${sys:infinispan.server.log.path}</Property>
    <Property name="accessLogPattern">%X{address} %X{user} [%d{dd/MMM/yyyy:HH:mm:ss Z}] &quot;%X{method} %m %X{protocol}&quot; %X{status} %X{requestSize} %X{responseSize} %X{duration}%n</Property>
  </Properties>
  <Appenders>
    <Console name="STDOUT">
      <PatternLayout pattern="%highlight{%d{yyyy-MM-dd HH:mm:ss,SSS} %-5p [%c{1.}] %m%throwable}{INFO=normal, DEBUG=normal, TRACE=normal}%n"/>
    </Console>

    <RollingFile name="FILE" createOnDemand="true"
                 fileName="${path}/server.log"
                 filePattern="${path}/server.log.%d{yyyy-MM-dd}-%i">
      <Policies>
        <OnStartupTriggeringPolicy />
        <SizeBasedTriggeringPolicy size="100 MB" />
        <TimeBasedTriggeringPolicy />
      </Policies>
      <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss,SSS} %-5p (%t) [%c{1.}] %m%throwable%n"/>
    </RollingFile>

    <RollingFile name="AUDIT-FILE" createOnDemand="true"
                 fileName="${path}/audit.log"
                 filePattern="${path}/audit.log.%d{yyyy-MM-dd}-%i">
      <Policies>
        <OnStartupTriggeringPolicy />
        <SizeBasedTriggeringPolicy size="900 MB" />
        <TimeBasedTriggeringPolicy />
      </Policies>
      <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss,SSS} %m%n"/>
    </RollingFile>
  </Appenders>

  <Loggers>
    <Root level="INFO">
      <AppenderRef ref="STDOUT" level="INFO"/>
      <AppenderRef ref="FILE"/>
    </Root>

    <!-- Fail-fast lock rejections: hold estimate, queue length and timeout at each rejection -->
    <Logger name="org.infinispan.util.concurrent.locks.impl.InfinispanLock" level="DEBUG"/>

    <!-- Conflict resolution: ISPN100012 when starting per-cache conflict resolution -->
<!--    <Logger name="org.infinispan.conflict" level="DEBUG"/>-->

    <!-- Partition handling strategy decisions -->
<!--    <Logger name="org.infinispan.partitionhandling" level="DEBUG"/>-->

    <!-- Lock acquisition and timeout: ISPN000299 on lock timeout -->
<!--    <Logger name="org.infinispan.util.concurrent.locks" level="TRACE"/>-->
<!--    <Logger name="org.infinispan.transaction.impl.TransactionTable" level="TRACE"/>-->

    <!-- Transaction completion and reaper activity -->
<!--    <Logger name="org.infinispan.transaction" level="DEBUG"/>-->

    <!-- State transfer interceptor: retry loop, topology waits, CancellableRetry -->
<!--    <Logger name="org.infinispan.statetransfer" level="TRACE"/>-->

    <!-- Replication/distribution interceptor: RPC dispatch for write commands -->
<!--    <Logger name="org.infinispan.interceptors.distribution" level="DEBUG"/>-->

    <!-- RPC manager: outbound RPCs, timeouts, responses -->
<!--    <Logger name="org.infinispan.remoting.transport.jgroups" level="TRACE"/>-->
<!--    <Logger name="org.infinispan.remoting.inboundhandler" level="TRACE"/>-->

    <!-- Topology changes: topology ID changes that trigger OutdatedTopologyException -->
<!--    <Logger name="org.infinispan.topology" level="TRACE"/>-->

<!--    <Logger name="org.infinispan.interceptors.distribution.TxDistributionInterceptor" level="TRACE"/>-->
<!--    <Logger name="org.infinispan.interceptors.locking.PessimisticLockingInterceptor" level="TRACE"/>-->
<!--    <Logger name="org.infinispan.statetransfer.StateTransferInterceptor" level="TRACE"/>-->

<!--    <Logger name="org.infinispan.interceptors.impl.InvocationContextInterceptor" level="OFF"/>-->
<!--    <Logger name="org.infinispan.interceptors.impl.AsyncInterceptorChainImpl" level="OFF"/>-->
<!--    <Logger name="org.infinispan.CLUSTER" level="OFF"/>-->
<!--    <Logger name="org.infinispan.SERVER" level="INFO">-->
<!--      <BurstFilter level="WARN" rate="10" maxBurst="100"/>-->
<!--    </Logger>-->

<!--    <Logger name="org.infinispan.interceptors.impl.AsyncInterceptorChainImpl" level="ERROR">-->
<!--      <Filters>-->
<!--        <BurstFilter level="ERROR" rate="20" maxBurst="50"/>-->
<!--      </Filters>-->
<!--    </Logger>-->

<!--    <Logger name="org.infinispan.CLUSTER" level="WARN">-->
<!--      <Filters>-->
<!--        <BurstFilter level="WARN" rate="20" maxBurst="50"/>-->
<!--      </Filters>-->
<!--    </Logger>-->

    <Logger name="org.infinispan.FREQUENT">
      <Filters>
        <BurstFilter level="ERROR" rate="20" maxBurst="50"/>
      </Filters>
    </Logger>

    <Logger name="org.infinispan" level="INFO"/>

    <Logger name="com.arjuna" level="WARN"/>
    <Logger name="org.jboss.threads" level="WARN"/>
    <Logger name="io.netty.handler.ssl.ApplicationProtocolNegotiationHandler" level="ERROR"/>

    <Logger name="org.infinispan.remoting.transport.jgroups.BaseJGroupsMetricManager" level="DEBUG"/>

    <Logger name="org.infinispan.AUDIT" additivity="false" level="ERROR">
      <AppenderRef ref="AUDIT-FILE"/>
    </Logger>
  </Loggers>
</Configuration>
